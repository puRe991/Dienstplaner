<Window x:Class="Dienstplaner.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Enterprise Dienstplaner"
        Height="920"
        Width="1450">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <UniformGrid Rows="1" Columns="4" Margin="0,0,0,8">
            <GroupBox Header="Mitarbeiter"><TextBlock Margin="8" Text="{Binding GesamtMitarbeiter}" FontSize="20" FontWeight="Bold"/></GroupBox>
            <GroupBox Header="Aktiv"><TextBlock Margin="8" Text="{Binding AktiveMitarbeiter}" FontSize="20" FontWeight="Bold"/></GroupBox>
            <GroupBox Header="Schichten"><TextBlock Margin="8" Text="{Binding GesamtSchichten}" FontSize="20" FontWeight="Bold"/></GroupBox>
            <GroupBox Header="Offener Bedarf"><TextBlock Margin="8" Text="{Binding OffeneBedarfe}" FontSize="20" FontWeight="Bold"/></GroupBox>
        </UniformGrid>

        <GroupBox Grid.Row="1" Header="Filter &amp; Anlage" Margin="0,0,0,8">
            <StackPanel Margin="8">
                <WrapPanel>
                    <TextBlock Text="Abteilung:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <ComboBox Width="220" Margin="0,0,16,0" ItemsSource="{Binding Abteilungen}" SelectedItem="{Binding GewaehlteAbteilungFilter}"/>
                    <TextBlock Text="Mitarbeiter-Suche:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBox Width="220" Text="{Binding MitarbeiterFilterText, UpdateSourceTrigger=PropertyChanged}"/>
                </WrapPanel>
                <WrapPanel Margin="0,8,0,0">
                    <TextBox Width="170" Margin="0,0,8,0" Text="{Binding NeuerMitarbeiterName, UpdateSourceTrigger=PropertyChanged}"/>
                    <TextBox Width="140" Margin="0,0,8,0" Text="{Binding NeueMitarbeiterAbteilung, UpdateSourceTrigger=PropertyChanged}"/>
                    <TextBox Width="140" Margin="0,0,8,0" Text="{Binding NeuerMitarbeiterQualifikation, UpdateSourceTrigger=PropertyChanged}"/>
                    <TextBox Width="80" Margin="0,0,8,0" Text="{Binding NeuesMitarbeiterWochenlimit, UpdateSourceTrigger=PropertyChanged}"/>
                    <Button Content="Mitarbeiter hinzufügen" Command="{Binding MitarbeiterHinzufuegenCommand}"/>
                </WrapPanel>
                <WrapPanel Margin="0,8,0,0">
                    <TextBox Width="170" Margin="0,0,8,0" Text="{Binding NeueSchichtName, UpdateSourceTrigger=PropertyChanged}"/>
                    <TextBox Width="140" Margin="0,0,8,0" Text="{Binding NeueSchichtAbteilung, UpdateSourceTrigger=PropertyChanged}"/>
                    <DatePicker Width="160" Margin="0,0,8,0" SelectedDate="{Binding NeueSchichtStart}"/>
                    <DatePicker Width="160" Margin="0,0,8,0" SelectedDate="{Binding NeueSchichtEnde}"/>
                    <TextBox Width="80" Margin="0,0,8,0" Text="{Binding NeueSchichtKapazitaet, UpdateSourceTrigger=PropertyChanged}"/>
                    <TextBox Width="140" Margin="0,0,8,0" Text="{Binding NeueSchichtQualifikation, UpdateSourceTrigger=PropertyChanged}"/>
                    <Button Content="Schicht hinzufügen" Command="{Binding SchichtHinzufuegenCommand}"/>
                </WrapPanel>
            </StackPanel>
        </GroupBox>

        <GroupBox Grid.Row="2" Header="Zuweisung" Margin="0,0,0,8">
            <StackPanel Orientation="Horizontal" Margin="8">
                <ComboBox Width="350" Margin="0,0,8,0" ItemsSource="{Binding MitarbeiterView}" DisplayMemberPath="Name" SelectedItem="{Binding AusgewaehlterMitarbeiter}"/>
                <ComboBox Width="350" Margin="0,0,8,0" ItemsSource="{Binding SchichtView}" DisplayMemberPath="Name" SelectedItem="{Binding AusgewaehlteSchicht}"/>
                <Button Width="160" Content="Zuweisen" Command="{Binding ZuweisenCommand}"/>
            </StackPanel>
        </GroupBox>

        <Border Grid.Row="3" Background="#FFEEF6FF" BorderBrush="#FFB7D8FF" BorderThickness="1" Padding="10" Margin="0,0,0,8">
            <TextBlock Text="{Binding StatusNachricht}" FontWeight="SemiBold"/>
        </Border>

        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="3*"/></Grid.ColumnDefinitions>

            <GroupBox Grid.Column="0" Header="Mitarbeiterliste" Margin="0,0,8,0">
                <DataGrid ItemsSource="{Binding MitarbeiterView}" AutoGenerateColumns="False" IsReadOnly="True">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="50"/>
                        <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*"/>
                        <DataGridTextColumn Header="Abteilung" Binding="{Binding Abteilung}" Width="120"/>
                        <DataGridTextColumn Header="Qualifikation" Binding="{Binding Qualifikation}" Width="120"/>
                        <DataGridTextColumn Header="Stunden" Binding="{Binding WochenstundenLimit}" Width="80"/>
                    </DataGrid.Columns>
                </DataGrid>
            </GroupBox>

            <GroupBox Grid.Column="1" Header="Schichtplan">
                <DataGrid ItemsSource="{Binding SchichtView}" AutoGenerateColumns="False" IsReadOnly="True">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Schicht" Binding="{Binding Name}" Width="140"/>
                        <DataGridTextColumn Header="Abteilung" Binding="{Binding Abteilung}" Width="120"/>
                        <DataGridTextColumn Header="Start" Binding="{Binding Start, StringFormat=dd.MM.yyyy HH:mm}" Width="140"/>
                        <DataGridTextColumn Header="Ende" Binding="{Binding Ende, StringFormat=dd.MM.yyyy HH:mm}" Width="140"/>
                        <DataGridTextColumn Header="Bedarf" Binding="{Binding BenoetigteMitarbeiter}" Width="70"/>
                        <DataGridTextColumn Header="Qualifikation" Binding="{Binding BenoetigteQualifikation}" Width="120"/>
                        <DataGridTextColumn Header="Zugewiesen" Binding="{Binding MitarbeiterNamen.Count}" Width="80"/>
                    </DataGrid.Columns>
                </DataGrid>
            </GroupBox>
        </Grid>
    </Grid>
</Window>
