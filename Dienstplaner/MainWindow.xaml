<Window x:Class="Dienstplaner.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Dienstplaner"
        Height="750"
        Width="1200">

    <Grid Margin="10">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- MITARBEITER -->
        <StackPanel Orientation="Horizontal" Margin="5">

            <TextBox Width="200"
                     Margin="5"
                     Text="{Binding NeuerMitarbeiterName, UpdateSourceTrigger=PropertyChanged}"/>

            <Button Content="Mitarbeiter hinzufügen"
                    Width="180"
                    Margin="5"
                    Command="{Binding MitarbeiterHinzufuegenCommand}"/>

        </StackPanel>

        <!-- SCHICHT -->
        <StackPanel Orientation="Horizontal" Margin="5" Grid.Row="1">

            <TextBox Width="200"
                     Margin="5"
                     Text="{Binding NeueSchichtName, UpdateSourceTrigger=PropertyChanged}"/>

            <Button Content="Schicht hinzufügen"
                    Width="180"
                    Margin="5"
                    Command="{Binding SchichtHinzufuegenCommand}"/>

        </StackPanel>

        <!-- ZUWEISUNG -->
        <StackPanel Orientation="Horizontal" Margin="5" Grid.Row="2">

            <ComboBox Width="220"
                      Margin="5"
                      ItemsSource="{Binding MitarbeiterListe}"
                      DisplayMemberPath="Name"
                      SelectedItem="{Binding AusgewaehlterMitarbeiter}"/>

            <ComboBox Width="220"
                      Margin="5"
                      ItemsSource="{Binding SchichtListe}"
                      DisplayMemberPath="Name"
                      SelectedItem="{Binding AusgewaehlteSchicht}"/>

            <Button Content="Zuweisen"
                    Width="120"
                    Margin="5"
                    Command="{Binding ZuweisenCommand}"/>

        </StackPanel>

        <!-- ANSICHT -->
        <GroupBox Header="Dienstplan" Grid.Row="3" Margin="5">

            <ListBox ItemsSource="{Binding SchichtListe}">

                <ListBox.ItemTemplate>
                    <DataTemplate>

                        <StackPanel Margin="5">

                            <TextBlock Text="{Binding Name}" FontWeight="Bold"/>
                            <TextBlock Text="{Binding Start}"/>
                            <TextBlock Text="{Binding Ende}"/>

                            <TextBlock Text="Mitarbeiter:" Margin="0,5,0,0"/>

                            <ItemsControl ItemsSource="{Binding MitarbeiterNamen}"/>

                        </StackPanel>

                    </DataTemplate>

                </ListBox.ItemTemplate>

            </ListBox>

        </GroupBox>

    </Grid>
</Window>